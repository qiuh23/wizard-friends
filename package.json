{
  "name": "wizard-friends",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-info.mjs",
    "test:layout": "node scripts/layout-review.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "worker:check": "wrangler deploy --dry-run --outdir .local/worker-dry-run",
    "test:smoke": "node scripts/authority-smoke.mjs",
    "test:refresh": "node scripts/refresh-smoke.mjs",
    "test:spectator": "node scripts/spectator-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:variants": "node scripts/variant-browser-smoke.mjs",
    "test:graphics": "node scripts/graphics-smoke.mjs",
    "test:presence": "node scripts/presence-smoke.mjs",
    "test:music": "node scripts/music-smoke.mjs",
    "test:network": "node scripts/network-smoke.mjs",
    "dev:relay": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "build:cloudflare": "npm run check && npm test && npm run build && npm run worker:check",
    "deploy:cloudflare": "wrangler deploy && node scripts/verify-deployment.mjs",
    "test:continuation": "node scripts/continuation-smoke.mjs",
    "test:offline": "node scripts/offline-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "0.25.12",
    "miniflare": "5.20261019.1-beta",
    "vite": "^6.4.4",
    "wrangler": "^4.151.3"
  }
}
